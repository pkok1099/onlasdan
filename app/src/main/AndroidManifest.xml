<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Wajib untuk job berkendala jaringan (NETWORK_TYPE_ANY): tanpa izin
         ini JobScheduler.schedule() melempar SecurityException (akar masalah
         unduhan beta.19-23, terbukti dari log diagnostik beta.23). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ComicApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComicReader">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ComicReader"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Links for Next.js URL Structure -->
            <intent-filter
                android:autoVerify="true"
                tools:ignore="AppLinksAutoVerify">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

	                <data android:scheme="https" />
	                <data android:host="comic-reader.pages.dev" /> <!-- Replace with actual production host if known -->

	                <!-- Komikindo patterns -->
	                <data android:pathPrefix="/komikindo/comic/" />
	                <data android:pathPrefix="/komikindo/read/" />

                <!-- Komiku patterns -->
                <data android:pathPrefix="/komiku/comic/" />
                <data android:pathPrefix="/komiku/read/" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.download.DownloadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
