root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_code_style = android_studio
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_filename = disabled
ktlint_standard_kdoc = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_max-line-length = disabled
ktlint_compose_modifier-missing-check = disabled
ktlint_compose_compositionlocal-allowlist = disabled
ktlint_compose_parameter-naming = disabled
ktlint_compose_modifier-not-used-at-root = disabled
ktlint_compose_param-order-check = disabled
ktlint_compose_mutable-state-param-check = disabled
ktlint_compose_multiple-emitters-check = disabled
ktlint_compose_lambda-param-in-effect = disabled
ktlint_compose_modifier-reused-check = disabled
ktlint_compose_modifier-composed-check = disabled

[**.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_code_style = android_studio
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_filename = disabled
ktlint_standard_kdoc = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_max-line-length = disabled
ktlint_compose_modifier-missing-check = disabled
ktlint_compose_compositionlocal-allowlist = disabled
ktlint_compose_parameter-naming = disabled
ktlint_compose_modifier-not-used-at-root = disabled
ktlint_compose_param-order-check = disabled
ktlint_compose_mutable-state-param-check = disabled
ktlint_compose_multiple-emitters-check = disabled
ktlint_compose_lambda-param-in-effect = disabled
ktlint_compose_modifier-reused-check = disabled
ktlint_compose_modifier-composed-check = disabled
